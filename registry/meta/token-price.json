{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "token-price",
  "type": "registry:ui",
  "title": "Token Price",
  "description": "Formats token prices with optional positive, negative, or neutral change.",
  "docs": "```tsx\nimport { TokenPrice } from \"@/components/ui/token-price\"\n\n<TokenPrice value={2456.78} change={2.34} />\n```",
  "dependencies": [
    "lucide-react"
  ],
  "devDependencies": [],
  "registryDependencies": [],
  "cssVars": {
    "theme": {
      "color-positive": "var(--positive)",
      "color-negative": "var(--negative)"
    },
    "light": {
      "positive": "oklch(0.596 0.145 163.225)",
      "negative": "oklch(0.577 0.245 27.325)"
    },
    "dark": {
      "positive": "oklch(0.765 0.177 163.223)",
      "negative": "oklch(0.704 0.191 22.216)"
    }
  },
  "files": [
    {
      "path": "registry/onchain-ui/token-price.tsx",
      "type": "registry:ui",
      "target": "components/ui/token-price.tsx"
    },
    {
      "path": "lib/onchain/format.ts",
      "type": "registry:lib",
      "target": "lib/onchain/format.ts"
    }
  ]
}
