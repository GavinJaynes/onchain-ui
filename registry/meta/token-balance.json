{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "token-balance",
  "type": "registry:ui",
  "title": "Token Balance",
  "description": "Displays a token amount with optional logo, fiat value, and change.",
  "docs": "```tsx\nimport { TokenBalance } from \"@/components/ui/token-balance\"\n\n<TokenBalance amount={1.4321} symbol=\"ETH\" fiatValue={4982.11} />\n```",
  "dependencies": [
    "lucide-react",
    "viem@2.55.19"
  ],
  "devDependencies": [],
  "registryDependencies": [
    "tooltip"
  ],
  "cssVars": {
    "theme": {
      "color-positive": "var(--positive)",
      "color-negative": "var(--negative)"
    },
    "light": {
      "positive": "oklch(0.596 0.145 163.225)",
      "negative": "oklch(0.577 0.245 27.325)"
    },
    "dark": {
      "positive": "oklch(0.765 0.177 163.223)",
      "negative": "oklch(0.704 0.191 22.216)"
    }
  },
  "files": [
    {
      "path": "registry/onchain-ui/token-balance.tsx",
      "type": "registry:ui",
      "target": "components/ui/token-balance.tsx"
    },
    {
      "path": "registry/onchain-ui/token-logo.tsx",
      "type": "registry:ui",
      "target": "components/ui/token-logo.tsx"
    },
    {
      "path": "registry/onchain-ui/token-price.tsx",
      "type": "registry:ui",
      "target": "components/ui/token-price.tsx"
    },
    {
      "path": "lib/onchain/format.ts",
      "type": "registry:lib",
      "target": "lib/onchain/format.ts"
    },
    {
      "path": "lib/onchain/crypto-icons.tsx",
      "type": "registry:lib",
      "target": "lib/onchain/crypto-icons.tsx"
    }
  ]
}
